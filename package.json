    "dsh",
    "dsh-plugin",
    "retry",
    "backoff"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imrcpan/dsh-retry.git"
  },
  "homepage": "https://github.com/imrcpan/dsh-retry#readme",
  "engines": {
    "node": ">=20.3.0",
    "dsh": ">=0.2.1-rc.2"
